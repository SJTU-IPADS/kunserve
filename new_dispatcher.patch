+    def _pad_dim0(
+        self,
+        tensor: torch.Tensor,
+        *,
+        max_m: int,
+        pad_value: float | int = 0,
+    ) -> torch.Tensor:
+        local_m = int(tensor.shape[0])
+        if local_m == max_m:
+            return tensor.contiguous()
+        out = torch.full(
+            (max_m, *tensor.shape[1:]),
+            pad_value,
+            dtype=tensor.dtype,
+            device=tensor.device,
+        )
+        if local_m > 0:
+            out[:local_m].copy_(tensor)
+        return out
