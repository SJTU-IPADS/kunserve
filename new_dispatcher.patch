+                "master=%s:%d world=%d group=%s backend=%s",
+                lane_idx,
+                master_address,
+                lane_port,
+                num_replicas,
+                lane_group_name,
+                self.backend,
+            )
+            init_results = await asyncio.gather(
+                *[
+                    replica.init_weights_update_group(
